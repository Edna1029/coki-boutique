rules_version = '2';

// Coki Boutique — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// Roles live in users/{uid}.role ("owner" | "admin" | "employee").
// Only an owner can create or change user records (and therefore roles),
// so nobody can promote themselves.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return hasProfile() && role() == 'owner';
    }

    function isStaff() {
      return hasProfile() && role() in ['owner', 'admin', 'employee'];
    }

    // User records: you can read your own; owners/admins can read all;
    // only owners can create, change or delete them.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || (hasProfile() && role() in ['owner', 'admin']));
      allow write: if isOwner();
    }

    // Store data (products, sales, credit, payments, logs, backups):
    // any signed-in staff member with a role. The `users` collection is
    // excluded here so this rule can never be used to edit roles.
    match /{collection}/{docId} {
      allow read, write: if collection != 'users' && isStaff();
    }
  }
}
